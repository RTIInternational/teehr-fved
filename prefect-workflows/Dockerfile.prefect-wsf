FROM prefecthq/prefect:3.4.24-python3.12

USER root
ARG TARGETARCH
ARG UV_VERSION=0.13.7

RUN test "${TARGETARCH}" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends git patch \
    && rm -rf /var/lib/apt/lists/*

# Flow-side dependencies (system Python, alongside Prefect).
RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}" \
    "boto3>=1.35,<2" pandas pytest

# Model dependencies live in their own locked venv, isolated from Prefect.
ENV UV_PROJECT_ENVIRONMENT=/opt/wsfr-venv
COPY wsfr_inference/pyproject.toml wsfr_inference/uv.lock /opt/wsfr-inference/
RUN uv sync --project /opt/wsfr-inference --locked --no-dev --no-install-project \
        --python /usr/local/bin/python \
    && rm -rf /root/.cache/uv
ENV WSF_MODEL_PYTHON=/opt/wsfr-venv/bin/python

RUN mkdir -p /teehr/workflows
COPY prefect-local.yaml /teehr/prefect-local.yaml
COPY prefect-remote.yaml /teehr/prefect-remote.yaml
COPY workflows/ /teehr/workflows/
COPY wsfr_inference/ /teehr/wsfr_inference/
# Match the teehr image's UID 1000 user (pods run as runAsUser: 1000).
RUN groupadd -g 1000 prefect \
    && useradd -u 1000 -g 1000 -m -d /home/prefect prefect \
    && mkdir -p /data/wsf && chown prefect:prefect /data/wsf

USER prefect
WORKDIR /teehr
